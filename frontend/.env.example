# Both the Next.js server (server components) and the browser (via the
# same SSH-tunneled port number) reach the FastAPI backend at this one
# URL — see kairodex.api.main's own docstring and docs/PROGRESS.md §12
# for why the API binds 127.0.0.1 and isn't reachable any other way.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
