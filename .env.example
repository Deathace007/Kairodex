# Copy to .env and fill in. Never commit .env.

# --- Database ---
POSTGRES_USER=kairodex
POSTGRES_PASSWORD=kairodex_dev_password
POSTGRES_DB=kairodex
DATABASE_URL=postgresql+asyncpg://kairodex:kairodex_dev_password@localhost:5432/kairodex
# Least-privilege app role (ARCHITECTURE.md Principle 2 / §5.4) — created by
# alembic migration app_role_separation. Leave unset until that migration
# has run; the app falls back to DATABASE_URL (see store/base.py).
KAIRODEX_APP_DB_PASSWORD=kairodex_app_dev_password
APP_DATABASE_URL=postgresql+asyncpg://kairodex_app:kairodex_app_dev_password@localhost:5432/kairodex

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Upstox (NSE) ---
# Analytics Token: long-lived (1yr), read-only, covers market data + option
# chain + historical candles + websocket — no daily OAuth needed for ingestion.
# Generate at: Developer Apps page -> Analytics tab -> Generate Token.
UPSTOX_ACCESS_TOKEN=
UPSTOX_TOKEN_EXPIRES_AT=2027-01-01

# --- LondonStrategicEdge (US) ---
LSE_API_KEY=

# --- App ---
KAIRODEX_ENV=development
KAIRODEX_PAPER_ONLY=true
